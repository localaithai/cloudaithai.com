{
  "name": "cloud-ai-thailand",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 17007",
    "build": "node vendor/mimir-blog/verify.mjs && node vendor/mimir-blog/social-images.mjs && astro build",
    "preview": "astro preview --port 17007",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "astro check",
    "seo:audit": "node scripts/seo-audit.mjs \"${SITE_URL:-https://cloudaithai.com}\" --ai-bots --max=50"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.1",
    "@mdx-js/mdx": "^3.1.1",
    "astro": "^7.3.8",
    "framer-motion": "^12.36.0",
    "github-slugger": "^2.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.12",
    "@fontsource/noto-sans": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.5",
    "satori": "^0.59.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18.0"
  }
}
