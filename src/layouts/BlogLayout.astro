---
import SitePage from "@/layouts/SitePage.astro";
import type { PageHead } from "@/lib/seo";

type Props = { head: PageHead };

const { head } = Astro.props;
---

<SitePage head={head}>
  <link
    slot="head"
    rel="alternate"
    type="application/rss+xml"
    href="/blog/feed.xml"
    title="RSS"
  />
  <slot />
</SitePage>
