---
import Contact from "@/components/Contact.astro";
import Footer from "@/components/Footer.astro";
import Navbar from "@/components/Navbar";
import Base from "@/layouts/Base.astro";
import type { PageHead } from "@/lib/seo";

type Props = { head: PageHead; inkTop?: boolean };

const { head, inkTop = false } = Astro.props;
---

<Base head={head}>
  <slot name="head" slot="head" />
  <Navbar client:load currentPath={Astro.url.pathname} onInk={inkTop} />
  <main id="content" class="min-h-screen">
    {inkTop ? null : <div class="pt-16"></div>}
    <slot />
    <Contact />
  </main>
  <Footer />
</Base>
