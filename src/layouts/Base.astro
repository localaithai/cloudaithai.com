---
import { Font } from "astro:assets";
import OmniToaster from "@/components/omni-toaster";
import JsonLd from "@/components/seo/JsonLd.astro";
import type { PageHead } from "@/lib/seo";
import { site } from "@/lib/site";
import { siteGraph } from "@/lib/structured-data";
import "@/styles/global.css";

type Props = { head: PageHead };

const { head } = Astro.props;
const { openGraph: og, twitter } = head;
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bingVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
---

<!doctype html>
<html lang={site.htmlLang} class="motion-safe:scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <link
      rel="alternate"
      type="text/plain"
      href="/llms.txt"
      title="LLM-friendly summary"
    />
    <slot name="head" />
    <title>{head.title}</title>
    {head.noindex ? <meta name="robots" content="noindex" /> : null}
    <meta name="description" content={head.description} />
    <link rel="manifest" href="/manifest.webmanifest" />
    {
      googleVerification ? (
        <meta name="google-site-verification" content={googleVerification} />
      ) : null
    }
    {
      bingVerification ? (
        <meta name="msvalidate.01" content={bingVerification} />
      ) : null
    }
    <link rel="canonical" href={head.canonical} />
    <meta property="og:title" content={og.title} />
    <meta property="og:description" content={og.description} />
    <meta property="og:url" content={og.url} />
    <meta property="og:site_name" content={og.siteName} />
    <meta property="og:locale" content={og.locale} />
    {
      og.images.map((image) => (
        <>
          <meta property="og:image" content={image.url} />
          {image.type ? (
            <meta property="og:image:type" content={image.type} />
          ) : null}
          {image.width ? (
            <meta property="og:image:width" content={String(image.width)} />
          ) : null}
          {image.height ? (
            <meta property="og:image:height" content={String(image.height)} />
          ) : null}
          {image.alt ? (
            <meta property="og:image:alt" content={image.alt} />
          ) : null}
        </>
      ))
    }
    <meta property="og:type" content={og.type} />
    {
      og.publishedTime ? (
        <meta property="article:published_time" content={og.publishedTime} />
      ) : null
    }
    {
      og.modifiedTime ? (
        <meta property="article:modified_time" content={og.modifiedTime} />
      ) : null
    }
    <meta name="twitter:card" content={twitter.card} />
    <meta name="twitter:title" content={twitter.title} />
    <meta name="twitter:description" content={twitter.description} />
    {twitter.images.map((url) => <meta name="twitter:image" content={url} />)}
    {/* The query string is the Next.js build hash, kept so cached favicon URLs stay valid. */}
    <link
      rel="icon"
      href="/favicon.ico?favicon.0b3bf435.ico"
      sizes="256x256"
      type="image/x-icon"
    />
    <Font cssVariable="--font-bai" preload />
  </head>
  <body class="antialiased">
    <JsonLd data={siteGraph()} />
    <slot />
    <script is:inline src="https://localai-omni.vercel.app/cta.js" defer></script>
    <script
      is:inline
      src="https://localai-omni.vercel.app/analytics.js"
      defer></script>
    <OmniToaster client:idle />
  </body>
</html>

<script>
  const items = document.querySelectorAll<HTMLElement>("[data-reveal]");
  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("is-in");
          observer.unobserve(entry.target);
        }
      },
      { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
    );
    // Anything already on screen at load shows at once; only later content animates in.
    for (const item of items) {
      if (item.getBoundingClientRect().top < window.innerHeight) {
        item.dataset.reveal = "instant";
        item.classList.add("is-in");
      } else {
        observer.observe(item);
      }
    }
  } else {
    for (const item of items) item.classList.add("is-in");
  }
</script>
