---
import Print from "@/components/Print.astro";
import { models } from "@/lib/site-data";
---

<section id="models" class="band band-wash">
  <div class="shell grid items-center gap-x-16 gap-y-12 lg:grid-cols-12">
    <Print path="/photo/model-choice.webp" alt="ผู้ใช้เลือกโมเดลคลาวด์จากแล็ปท็อปบนโต๊ะทำงาน" class="order-last aspect-[3/2] rounded-xl lg:order-first lg:col-span-6" />
    <div class="lg:col-span-6">
      <h2 data-reveal class="reveal-on-scroll text-h2">เลือกโมเดลให้เหมาะกับงาน</h2>
      <p data-reveal style="--i:1" class="reveal-on-scroll mt-5 max-w-[36ch] text-lead text-ink-2">
        ใน Suite คุณเลือก Claude, Gemini, GPT หรือ DeepSeek
        สำหรับงานที่กำลังทำได้
      </p>
      <ul class="m-0 mt-10 list-none border-b border-line p-0">
        {
          models.map((model, index) => (
            <li data-reveal style={`--i:${index}`} class="reveal-on-scroll border-t border-line py-3 font-display text-[clamp(2rem,1.4rem+2.6vw,3.25rem)] [line-height:1.25] font-light">
              {model}
            </li>
          ))
        }
      </ul>
      <p class="mt-6 text-meta text-ink-2">
        ค่าใช้โมเดลยังไม่กำหนด, ติดต่อเราเพื่อคุยความต้องการ
      </p>
    </div>
  </div>
</section>
