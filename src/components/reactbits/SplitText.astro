---
type Props = { text: string };
const { text } = Astro.props;
---

<span class="split-text" data-split-text={text}>
  <span class="sr-only">{text}</span>
  <span aria-hidden="true">{text.split(" ").map((word, index) => <><span class="inline-block motion-safe:animate-word-lift" style={`--word:${index}`}>{word}</span>{index < text.split(" ").length - 1 ? " " : ""}</>)}</span>
</span>
