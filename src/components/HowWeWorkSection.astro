---
import Print from "@/components/Print.astro";
import StepList from "@/components/StepList.astro";
---

<section class="band pt-10">
  <div class="shell grid gap-x-16 gap-y-12 lg:grid-cols-12">
    <div class="lg:sticky lg:top-28 lg:col-span-5 lg:self-start">
      <h2 class="text-title">เริ่มจากเครื่องของแต่ละคน</h2>
      <Print path="/photo/backup-folder.webp" alt="แล็ปท็อปกับแฟ้มและไดรฟ์สำรองข้อมูลบนโต๊ะทำงาน" eager class="mt-10 aspect-[3/2] rounded-xl" />
    </div>
    <div class="lg:col-span-7">
      <StepList headingLevel="h2" />
    </div>
  </div>
</section>
