---
import AppGroups from "@/components/AppGroups.astro";
import Pricing from "@/components/Pricing.astro";
import { mimirScopeNotice } from "@/lib/site-data";
---

<Pricing reveal={false} first />
<section class="pb-[clamp(4.5rem,9vw,8.5rem)]">
  <div class="shell">
    <p class="max-w-[60ch] text-meta text-ink-2">{mimirScopeNotice}</p>
    <AppGroups showPriceNote class="mt-10" />
  </div>
</section>
