---
import { faqs } from "@/lib/site-data";
---

<section class="band band-wash">
  <div class="shell grid gap-x-16 gap-y-10 lg:grid-cols-12">
    <h2 data-reveal class="reveal-on-scroll text-h2 lg:sticky lg:top-28 lg:col-span-4 lg:self-start">
      คำถามที่พบบ่อย
    </h2>
    <div class="border-b-2 border-ink lg:col-span-8">
      {
        faqs.map(([question, answer]) => (
          <details class="group border-t border-line first:border-t-2 first:border-ink">
            <summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-6 py-5 text-h3 font-semibold [&::-webkit-details-marker]:hidden">
              {question}
              <span aria-hidden="true" class="grid size-9 flex-none place-items-center rounded-full border-[1.5px] border-ink text-[1.25rem] [line-height:1] transition-[transform,background-color,color] duration-200 group-open:rotate-45 group-open:bg-ink group-open:text-white">
                +
              </span>
            </summary>
            <p class="max-w-[62ch] pr-12 pb-7 text-ink-2">{answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
