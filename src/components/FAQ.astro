---
import { faqs } from "@/lib/site-data";
---

<section class="apple-section section-gray">
  <div class="max-w-3xl mx-auto px-6">
    <h2 class="text-4xl sm:text-5xl font-semibold tracking-tight text-center">
      คำถามที่พบบ่อย
    </h2>
    <div class="mt-10 space-y-3">
      {
        faqs.map(([question, answer]) => (
          <details class="apple-card p-5 group">
            <summary class="cursor-pointer list-none font-semibold text-[#1d1d1f] flex justify-between gap-4">
              {question}
              <span class="text-[#0071e3] group-open:rotate-45 transition-transform">
                +
              </span>
            </summary>
            <p class="mt-3 pr-5 text-[#6e6e73] leading-relaxed">{answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
