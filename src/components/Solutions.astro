---
import Print from "@/components/Print.astro";
import { solutions } from "@/lib/site-data";
---

<section id="solutions" class="band">
  <div class="shell">
    <div class="grid gap-x-16 gap-y-6 lg:grid-cols-12 lg:items-end">
      <h2 data-reveal class="reveal-on-scroll text-h2 lg:col-span-7">แอปที่เริ่มจากงานจริง</h2>
      <p data-reveal style="--i:1" class="reveal-on-scroll text-lead text-ink-2 lg:col-span-5">
        เลือกแอปต่อ seat เพื่อช่วยงานเอกสาร ข้อมูล
        และเนื้อหาของคนทำงานแต่ละคน
      </p>
    </div>
    <div class="mt-14 grid gap-x-16 gap-y-12 lg:grid-cols-12">
      <Print path="/photo/document-workflow.webp" alt="เอกสารจากกองกระดาษผ่านแล็ปท็อปขึ้นไปยังคลาวด์ ข้างแฟ้มเอกสาร" class="aspect-[3/2] rounded-xl lg:sticky lg:top-28 lg:col-span-5 lg:aspect-[4/5] lg:self-start" />
      <ul class="m-0 list-none border-b-2 border-ink p-0 lg:col-span-7">
        {
          Object.entries(solutions).map(([slug, solution]) => (
            <li class="border-t border-line first:border-t-2 first:border-ink">
              <a
                href={`/solutions/${slug}/`}
                class="group invert-row -mx-4 grid gap-x-8 gap-y-2 px-4 py-6 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center"
              >
                <div class="min-w-0">
                  <h3 class="text-h3">
                    {solution.title.replace("Mimir Suites Cloud สำหรับ", "")}
                  </h3>
                  <p class="mt-1.5 max-w-[52ch] text-ink-2 transition-colors duration-200 group-hover:text-on-ink-2 group-focus-visible:text-on-ink-2">
                    {solution.intro}
                  </p>
                </div>
                <p class="inline-flex items-center gap-2 text-meta font-semibold after:transition-[transform] after:duration-300 after:content-['→'] motion-safe:group-hover:after:[transform:translateX(4px)]">
                  ดูแอปที่เกี่ยวข้อง
                </p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
