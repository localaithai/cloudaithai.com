---
import Reveal from "@/components/Reveal";
import { site } from "@/lib/site";
---

<section id="contact" class="apple-section">
  <div class="max-w-4xl mx-auto px-6">
    <Reveal client:visible className="text-center">
      <p data-reveal class="eyebrow text-[#0071e3] font-medium">{site.primaryCta.label}</p>
      <h2 data-reveal style="--i:1" class="mt-3 text-h2 font-semibold tracking-tight">
        เลือกแอปและ seat ที่ต้องการ
      </h2>
      <p data-reveal style="--i:2" class="mx-auto mt-4 max-w-[44rem] text-balance text-lead text-[#6e6e73]">
        บอกงาน จำนวนเครื่อง และแอปที่สนใจ เราจะช่วยเริ่มบทสนทนา
      </p>
    </Reveal>
    <Reveal client:visible>
      <div data-reveal style="--i:3" data-cta="form" class="max-w-xl mx-auto mt-9"></div>
    </Reveal>
    <p data-reveal class="mt-6 text-center text-sm text-[#6e6e73]">
      <a data-cta="email" class="underline"></a> <a data-cta="tel" class="underline"></a> <a data-cta="line" class="underline">LINE</a>
    </p>
  </div>
</section>
