---
import Reveal from "@/components/Reveal";
import { site } from "@/lib/site";
---

<section id="contact" class="apple-section">
  <div class="max-w-4xl mx-auto px-6">
    <Reveal client:visible className="text-center">
      <p class="text-[#0071e3] font-medium">{site.primaryCta.label}</p>
      <h2 class="mt-3 text-4xl sm:text-5xl font-semibold tracking-tight">
        เลือกแอปและ seat ที่ต้องการ
      </h2>
      <p class="mt-4 text-lg text-[#6e6e73]">
        บอกงาน จำนวนเครื่อง และแอปที่สนใจ เราจะช่วยเริ่มบทสนทนา
      </p>
    </Reveal>
    <Reveal client:visible>
      <div data-cta="form" class="max-w-xl mx-auto mt-9"></div>
    </Reveal>
    <p class="mt-6 text-center text-sm text-[#6e6e73]">
      <a data-cta="email" class="underline"></a> <a data-cta="tel" class="underline"></a> <a data-cta="line" class="underline">LINE</a>
    </p>
  </div>
</section>
