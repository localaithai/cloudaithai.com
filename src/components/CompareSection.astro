---
import Print from "@/components/Print.astro";
import { assetUrl } from "@/lib/assets";

const LOCAL_MACHINE_OPTIONS = [
  {
    name: "MSI EdgeXpert",
    path: "/msi-edgexpert.png",
    width: 520,
    height: 230,
  },
  { name: "Acer GN100", path: "/acer-gn100.jpg", width: 1306, height: 808 },
  { name: "ASUS Ascent GX10", path: "/asus-gx10.png", width: 498, height: 205 },
  {
    name: "Lenovo ThinkStation PGX",
    path: "/lenovo-pgx.png",
    width: 537,
    height: 281,
  },
] as const;
---

<section class="band pt-10">
  <div class="shell">
    <h2 class="text-title">Cloud หรือ AI machine</h2>
    <div class="mt-12 grid overflow-hidden rounded-xl border-2 border-ink md:grid-cols-2">
      <article class="band-ink p-[clamp(1.5rem,4vw,3rem)]">
        <h2 class="text-sub">Mimir Suites Cloud</h2>
        <p class="mt-4 max-w-[44ch] text-on-ink-2">
          Mimir Suite บนเครื่องพนักงาน ใช้โมเดลคลาวด์ ไม่ต้องซื้อเครื่อง AI
          แต่ข้อมูลเอกสารถูกส่งไปยังโมเดลคลาวด์หลังปิดทับข้อมูลส่วนบุคคลโดยค่าเริ่มต้น
        </p>
      </article>
      <article class="border-ink p-[clamp(1.5rem,4vw,3rem)] max-md:border-t-2 md:border-l-2">
        <h2 class="text-sub">Local edition</h2>
        <p class="mt-4 max-w-[44ch] text-ink-2">
          สำหรับองค์กรที่ต้องการทางเลือก on-site ด้วย AI machine
        </p>
        <a href="https://localaithai.com" class="link-arrow mt-5">
          ดู Local AI Thailand
        </a>
      </article>
    </div>
    <div class="mt-20 grid items-end gap-x-16 gap-y-10 lg:grid-cols-12">
      <div data-reveal class="reveal-on-scroll lg:col-span-7">
        <h3 class="text-sub">
          ตัวอย่างเครื่อง AI แบบ GB10 4 รุ่น สำหรับ Local edition เท่านั้น
        </h3>
        <p class="mt-4 max-w-[60ch] text-ink-2">
          เครื่องทั้งสี่รุ่นนี้เป็นตัวอย่างสำหรับ Local edition: Cloud edition
          ใช้โมเดลจากคลาวด์จึงไม่ต้องซื้อเครื่อง AI ส่วนรุ่นที่เหมาะกับ Local
          edition ขึ้นอยู่กับโมเดลและลักษณะงานขององค์กร
        </p>
      </div>
      <Print path="/photo/upgrade-path.webp" alt="แล็ปท็อปที่เชื่อมต่อคลาวด์ วางข้างเครื่อง AI ขนาดเล็กบนโต๊ะ" class="aspect-[3/2] rounded-xl lg:col-span-5" />
    </div>
    <div class="mt-10 grid grid-cols-2 border-t border-l border-line lg:grid-cols-4">
      {
        LOCAL_MACHINE_OPTIONS.map((machine, index) => (
          <figure data-reveal style={`--i:${index}`} class="reveal-on-scroll m-0 border-r border-b border-line p-5">
            <span class="print block">
              <img
                src={assetUrl(machine.path)}
                alt={`${machine.name}, ตัวอย่างเครื่อง AI แบบ GB10 สำหรับ Local edition`}
                width={machine.width}
                height={machine.height}
                loading="lazy"
                decoding="async"
                class="print-img h-24 w-full object-contain"
              />
            </span>
            <figcaption class="mt-4 text-meta font-semibold">{machine.name}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
