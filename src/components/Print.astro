---
import { assetUrl } from "@/lib/assets";

type Props = {
  /** Key in src/lib/assets.ts. */
  path: string;
  alt: string;
  width?: number;
  height?: number;
  eager?: boolean;
  class?: string;
};

const {
  path,
  alt,
  width = 1536,
  height = 1024,
  eager = false,
  class: className,
} = Astro.props;
---

<div class:list={["print", className]}>
  <img
    src={assetUrl(path)}
    alt={alt}
    width={width}
    height={height}
    loading={eager ? "eager" : "lazy"}
    decoding="async"
    class="print-img size-full object-cover contrast-110"
  />
</div>
