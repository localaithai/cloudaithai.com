---
import { assetUrl } from "@/lib/assets";
import { appMarkPath, solutions } from "@/lib/site-data";

type Props = { solution: keyof typeof solutions };

const item = solutions[Astro.props.solution];
---

<section class="apple-section">
  <div class="max-w-4xl mx-auto px-6">
    <p class="eyebrow text-[#0071e3] font-medium mb-3">Mimir Suites Cloud</p>
    <h1 class="text-h2 font-semibold tracking-tight">
      {item.title.replace("Mimir Suites Cloud สำหรับ", "")}
    </h1>
    <p class="mt-5 max-w-[44rem] text-lead text-[#6e6e73]">{item.intro}</p>
    <div class="mt-9 apple-card p-7">
      <h2 class="font-semibold text-[#1d1d1f]">แอปที่ใช้กับงานนี้</h2>
      <div class="mt-5 flex flex-wrap gap-2">
        {
          item.apps.map((app) => (
            <span class="inline-flex items-center gap-2 rounded-full bg-[#f5f5f7] px-4 py-2 text-sm font-medium">
              <img
                src={assetUrl(appMarkPath(app))}
                alt=""
                width="28"
                height="28"
                loading="lazy"
                decoding="async"
                class="size-7 object-contain"
              />
              {app}
            </span>
          ))
        }
      </div>
      <p class="mt-6 text-sm text-[#6e6e73]">
        หนึ่ง seat อยู่บนหนึ่งเครื่อง และข้อมูลของ seat นั้นเก็บบนเครื่องนั้น
      </p>
    </div>
  </div>
</section>
