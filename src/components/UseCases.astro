---
import Print from "@/components/Print.astro";
import { assetUrl } from "@/lib/assets";
import { appMarkPath, solutions } from "@/lib/site-data";

type Props = { solution: keyof typeof solutions };

const item = solutions[Astro.props.solution];
const photos: Record<keyof typeof solutions, { path: string; alt: string }> = {
  ecommerce: { path: "/photo/hero-cloud-workspace.webp", alt: "แล็ปท็อปเปิดอยู่บนโต๊ะทำงานริมหน้าต่าง เชื่อมต่อกับคลาวด์" },
  creator: { path: "/photo/solo-business.webp", alt: "คนทำงานพิมพ์บนแล็ปท็อปที่เชื่อมต่อคลาวด์" },
  legal: { path: "/photo/redaction-concept.webp", alt: "เอกสารบนโต๊ะที่ปิดทับข้อความบางส่วนด้วยแถบทึบก่อนส่งขึ้นคลาวด์" },
  healthcare: { path: "/photo/cloud-search.webp", alt: "แฟ้มเอกสารและแว่นขยายข้างแล็ปท็อปบนโต๊ะทำงาน" },
  realestate: { path: "/photo/document-to-cloud.webp", alt: "กองเอกสารข้างแล็ปท็อปที่ส่งข้อความขึ้นคลาวด์" },
  restaurant: { path: "/photo/remote-work.webp", alt: "ผู้หญิงทำงานบนแล็ปท็อปริมหน้าต่าง" },
};
const photo = photos[Astro.props.solution];
---

<section class="band-ink pt-[clamp(7.5rem,14vw,11rem)] pb-[clamp(3.5rem,7vw,6rem)]">
  <div class="shell grid items-end gap-x-16 gap-y-10 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <p class="kicker text-on-ink-2">Mimir Suites Cloud</p>
      <h1 class="mt-4 text-display motion-safe:animate-rise">
        {item.title.replace("Mimir Suites Cloud สำหรับ", "")}
      </h1>
      <p class="mt-6 max-w-[40ch] text-lead text-on-ink-2">{item.intro}</p>
    </div>
    <Print path={photo.path} alt={photo.alt} eager class="aspect-[3/2] rounded-xl lg:col-span-5" />
  </div>
</section>
<section class="band">
  <div class="shell grid gap-x-16 gap-y-8 border-t-2 border-ink pt-[clamp(2rem,4vw,3.5rem)] lg:grid-cols-12">
    <div class="lg:col-span-4">
      <h2 class="text-sub">แอปที่ใช้กับงานนี้</h2>
      <p class="mt-4 max-w-[36ch] text-meta text-ink-2">
        หนึ่ง seat อยู่บนหนึ่งเครื่อง และข้อมูลของ seat นั้นเก็บบนเครื่องนั้น
      </p>
    </div>
    <ul class="m-0 grid list-none grid-cols-2 gap-x-6 gap-y-7 p-0 sm:grid-cols-3 lg:col-span-8">
      {
        item.apps.map((app) => (
          <li class="flex items-center gap-3 sm:flex-col sm:items-start">
            <span class="print block size-12 flex-none rounded-lg">
              <img
                src={assetUrl(appMarkPath(app))}
                alt=""
                width="48"
                height="48"
                loading="lazy"
                decoding="async"
                class="print-img size-full object-contain"
              />
            </span>
            <span class="font-semibold">{app}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
