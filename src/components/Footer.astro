---
import { site } from "@/lib/site";
import { footer } from "@/lib/site-data";

const link = "hairline-link inline-flex min-h-11 items-center justify-self-start font-semibold";
---

<footer class="border-t-2 border-ink">
  <div class="shell grid gap-x-16 gap-y-10 py-[clamp(3.5rem,7vw,6rem)] lg:grid-cols-12">
    <div class="lg:col-span-5">
      <p class="font-display text-[clamp(1.75rem,1.4rem+1.6vw,2.5rem)] [line-height:1.3] font-semibold">
        CloudAI Thailand
      </p>
      <p class="mt-3 max-w-[30ch] text-ink-2">
        Mimir Suites Cloud สำหรับงานบนเครื่องพนักงาน
      </p>
      {
        site.legalDisclosure ? (
          <p class="mt-4 text-meta text-ink-2">{site.legalDisclosure}</p>
        ) : null
      }
    </div>
    <div class="grid grid-cols-2 content-start gap-x-8 text-meta sm:grid-cols-3 lg:col-span-7">
      {footer.map((item) => <a href={item.href} class={link}>{item.label}</a>)}
      <a href={site.primaryCta.href} class={link}>{site.primaryCta.label}</a>
    </div>
  </div>
  <div class="shell">
    <p class="border-t border-line py-6 text-meta text-ink-2">
      © 2026 CloudAI Thailand
    </p>
  </div>
</footer>
