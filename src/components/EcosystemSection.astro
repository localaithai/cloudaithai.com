---
import AppGroups from "@/components/AppGroups.astro";
import { assetUrl } from "@/lib/assets";
import { mimirScopeNotice, models } from "@/lib/site-data";
---

<section class="band pt-10">
  <div class="shell">
    <div class="flex items-center gap-3">
      <span class="print block w-[4.5rem] flex-none">
        <img
          src={assetUrl("/mimir-suite-logo.png")}
          alt=""
          width="72"
          height="48"
          loading="lazy"
          decoding="async"
          class="print-img h-12 w-full object-contain"
        />
      </span>
      <p class="kicker">Mimir Suites Cloud</p>
    </div>
    <h2 class="mt-5 text-title">แอปของคุณ, โมเดลที่เลือก</h2>
    <p class="mt-6 max-w-[44ch] text-lead text-ink-2">
      Mimir Suite รวมแอปบนเครื่องของแต่ละ seat และเชื่อมต่อโมเดลคลาวด์ตามงาน
    </p>
    <p class="mt-4 max-w-[60ch] text-meta text-ink-2">{mimirScopeNotice}</p>
    <ul class="m-0 mt-10 flex list-none flex-wrap gap-x-10 gap-y-2 border-y border-line p-0 py-5 font-display text-[clamp(1.5rem,1.2rem+1.4vw,2.25rem)] font-light">
      {models.map((model) => <li>{model}</li>)}
    </ul>
    <AppGroups class="mt-16" />
  </div>
</section>
