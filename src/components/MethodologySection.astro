---
import Print from "@/components/Print.astro";

const principles = [
  [
    "เริ่มที่งาน",
    "คุยว่างานเอกสาร เสียง รูป หรือข้อมูลส่วนไหนควรอยู่ใน Suite",
  ],
  ["กำหนด seat", "หนึ่งเครื่องต่อหนึ่ง seat และข้อมูลของแต่ละ seat ไม่แชร์กัน"],
  [
    "ตั้งค่าอย่างตรงไปตรงมา",
    "เลือกแอป โมเดล และโฟลเดอร์สำรองข้อมูลระหว่างตั้งค่า",
  ],
] as const;
---

<section class="band pt-10">
  <div class="shell">
    <div class="grid items-end gap-x-16 gap-y-10 lg:grid-cols-12">
      <h2 class="text-title lg:col-span-7">เลือกงานและข้อมูลก่อนเลือกแอป</h2>
      <Print path="/photo/solo-business.webp" alt="คนทำงานพิมพ์บนแล็ปท็อปที่เชื่อมต่อคลาวด์" eager class="aspect-[3/2] rounded-xl lg:col-span-5" />
    </div>
    <div class="mt-16 grid border-t-2 border-ink md:grid-cols-3">
      {
        principles.map(([title, text]) => (
          <article class="border-b border-line py-8 md:border-b-0 md:border-l md:px-8 md:first:border-l-0 md:first:pl-0 md:last:pr-0">
            <h2 class="text-h3">{title}</h2>
            <p class="mt-3 text-ink-2">{text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
