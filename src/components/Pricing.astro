---
import Print from "@/components/Print.astro";
import { site } from "@/lib/site";

type Props = { reveal?: boolean; tone?: "paper" | "wash"; first?: boolean };

const { reveal = true, tone = "paper", first = false } = Astro.props;
const revealAttr = reveal ? "" : undefined;
const revealClass = reveal ? "reveal-on-scroll" : "";
---

<section id="pricing" class:list={["band", tone === "wash" && "band-wash", first && "pt-10"]}>
  <div class="shell grid items-center gap-x-16 gap-y-12 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <h2 data-reveal={revealAttr} class:list={[revealClass, first ? "text-title" : "text-h2"]}>
        เลือกแอป, เลือก seat
      </h2>
      <div data-reveal={revealAttr} style="--i:1" class:list={[revealClass, "mt-10 border-y-2 border-ink py-8"]}>
        <p class="font-display text-[clamp(1.5rem,1.2rem+1.4vw,2.25rem)] [line-height:1.45]">
          Mimir Suites Cloud คิดราคา <strong class="font-bold">ต่อแอป ต่อ seat</strong>
        </p>
        <p class="mt-3 text-ink-2">
          ค่าใช้โมเดลยังไม่กำหนด จึงแสดงเป็น ติดต่อเรา
        </p>
      </div>
      <a href={site.primaryCta.href} class="btn btn-solid mt-8">
        {site.primaryCta.label}
      </a>
    </div>
    <Print path="/photo/team-seats.webp" alt="ทีมงานสามคนทำงานบนแล็ปท็อปของตัวเองคนละเครื่อง" eager={first} class="aspect-[3/2] rounded-xl lg:col-span-5" />
  </div>
</section>
