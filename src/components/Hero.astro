---
import RedactionDiagram from "@/components/RedactionDiagram.astro";
import SplitText from "@/components/reactbits/SplitText.astro";
import { assetUrl } from "@/lib/assets";
import { site } from "@/lib/site";
import { models } from "@/lib/site-data";
---

<section class="band-ink overflow-hidden">
  <div class="shell pt-[clamp(7rem,12vw,10.5rem)] pb-[clamp(2.5rem,5vw,4rem)]">
    <div class="grid items-end gap-x-16 gap-y-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="kicker text-on-ink-2"><SplitText text="Mimir Suites Cloud" /></p>
        <h1 class="mt-5 text-display motion-safe:animate-rise">
          AI บนทุกเครื่อง<br />ของทีมคุณ
        </h1>
        <p class="mt-7 max-w-[34ch] text-lead text-on-ink-2">
          ติดตั้ง Mimir Suite บนเครื่องพนักงาน เลือกแอปและโมเดลคลาวด์ได้เอง
          ไม่ต้องซื้อเครื่อง AI ไม่มีเซิร์ฟเวอร์ และไม่มีบริการโฮสต์จากเรา
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-x-7 gap-y-3">
          <a href={site.primaryCta.href} class="btn btn-paper">
            {site.primaryCta.label}
          </a>
          <a href="/pricing/" class="link-arrow">ดูรูปแบบราคา</a>
        </div>
      </div>
      <div class="rounded-xl border-[1.5px] border-white p-[clamp(1.25rem,2.5vw,2rem)] lg:col-span-5">
        <RedactionDiagram class="h-auto w-full max-w-[22rem]" />
        <p class="mt-6 text-[1.1875rem] [line-height:1.6] font-semibold">
          ข้อความเอกสารถูกส่งไปยังโมเดลคลาวด์ โดยปิดบัง PII เป็นค่าเริ่มต้น
        </p>
      </div>
    </div>

    <figure class="mt-[clamp(3rem,6vw,5rem)]">
      <div class="print aspect-[4.3] rounded-xl max-sm:aspect-[2.2]">
        <img
          src={assetUrl("/mimir-suites-home-1280.webp")}
          srcset={[640, 1280, 1920].map((width) => `${assetUrl(`/mimir-suites-home-${width}.webp`)} ${width}w`).join(", ")}
          sizes="(min-width: 1344px) 1850px, (min-width: 640px) 138vw, 240vw"
          alt="ตัวอย่างหน้ารวมแอป Mimir Suites"
          width="1280"
          height="804"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="print-img absolute bottom-0 left-1/2 h-auto w-[150%] max-w-none -translate-x-1/2 translate-y-[4.4%] max-sm:w-[260%] max-sm:translate-y-[3%]"
        />
      </div>
      <figcaption class="mt-3 text-meta text-on-ink-2">
        ตัวอย่างหน้ารวมแอป Mimir Suites · Cloud edition ใช้โมเดลคลาวด์
      </figcaption>
    </figure>

    <div class="mt-[clamp(2.5rem,5vw,4rem)] flex flex-col gap-x-10 gap-y-3 border-t border-on-ink-line pt-6 sm:flex-row sm:items-baseline">
      <p class="m-0 text-meta font-semibold text-on-ink-2">
        Choose a model for the work
      </p>
      <ul class="m-0 flex list-none flex-wrap gap-x-8 gap-y-1 p-0 font-display text-[clamp(1.25rem,1.1rem+0.8vw,1.75rem)] font-light">
        {models.map((model) => <li>{model}</li>)}
      </ul>
    </div>
  </div>
</section>
