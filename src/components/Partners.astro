---
import { assetUrl } from "@/lib/assets";

const partners = [
  { name: "Ingram Micro", logo: assetUrl("/partners/ingram-micro.svg") },
  { name: "TD SYNNEX", logo: assetUrl("/partners/td-synnex.svg") },
  { name: "SiS Distribution", logo: assetUrl("/partners/sis.png") },
  { name: "Ascenti", logo: assetUrl("/partners/ascenti-dark.png") },
  { name: "Eaton", logo: assetUrl("/partners/eaton.svg") },
  {
    name: "Schneider Electric",
    logo: assetUrl("/partners/schneider-electric.svg"),
  },
  { name: "VST ECS", logo: assetUrl("/partners/vst-ecs.png") },
] as const;
---

<section aria-labelledby="partners-heading" class="band">
  <div class="shell grid gap-x-16 gap-y-12 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <h2 id="partners-heading" data-reveal class="reveal-on-scroll text-h2">
        พร้อมเติบโตจาก cloud ไปถึงระบบเต็มรูปแบบ
      </h2>
      <p data-reveal style="--i:1" class="reveal-on-scroll mt-5 text-lead text-ink-2">
        Mimir Suites Cloud เริ่มได้โดยไม่ต้องมีเครื่อง AI
        และยังอยู่ในเครือข่ายพาร์ทเนอร์เดียวกับระบบ hardware และ infrastructure
        เมื่อต้องการขยายภายหลัง
      </p>
    </div>
    <ul class="m-0 grid list-none grid-cols-2 self-start border-t border-l border-line p-0 sm:grid-cols-4 lg:col-span-7">
      {
        partners.map((partner) => (
          <li class="border-r border-b border-line p-5">
            <span class="print block">
              <img
                src={partner.logo}
                alt={`${partner.name} logo`}
                width="160"
                height="64"
                loading="lazy"
                decoding="async"
                class="print-img h-12 w-full object-contain contrast-125"
              />
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
