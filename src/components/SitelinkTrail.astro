---
import { site } from "@/lib/site";
import { type RoutePath, routeAt } from "@/lib/site-data";

type Props = { path: RoutePath };

const route = routeAt(Astro.props.path);
const sitelinkName = "sitelinkName" in route ? route.sitelinkName : undefined;
if (!sitelinkName) throw new Error(`Missing sitelink name for ${route.path}`);

const breadcrumb = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: site.url },
    { "@type": "ListItem", position: 2, name: sitelinkName },
  ],
}).replaceAll("<", "\\u003c");
---

<nav aria-label="Breadcrumb" class="shell pt-8 text-meta text-ink-2">
  <ol class="m-0 flex list-none items-center gap-2 p-0">
    <li>
      <a href="/" class="inline-flex min-h-11 items-center underline-offset-[0.3em] hover:text-ink hover:underline">Home</a>
    </li>
    <li aria-hidden="true">/</li>
    <li aria-current="page" class="font-semibold text-ink">{sitelinkName}</li>
  </ol>
</nav>
<h1 class="sr-only">{sitelinkName}</h1>
<script type="application/ld+json" set:html={breadcrumb} />
