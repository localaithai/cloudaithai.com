---
import Contact from "@/components/Contact.astro";
import DataHandlingSection from "@/components/DataHandlingSection.astro";
import FAQ from "@/components/FAQ.astro";
import Footer from "@/components/Footer.astro";
import Hero from "@/components/Hero.astro";
import Models from "@/components/Models.astro";
import Navbar from "@/components/Navbar";
import Partners from "@/components/Partners.astro";
import Pricing from "@/components/Pricing.astro";
import ScrollShowcase from "@/components/ScrollShowcase.astro";
import Solutions from "@/components/Solutions.astro";
import Base from "@/layouts/Base.astro";
import { pageHead } from "@/lib/seo";
import { mimirScopeNotice } from "@/lib/site-data";
---

<Base head={pageHead("/")}>
  <Navbar client:load currentPath={Astro.url.pathname} onInk />
  <main id="content">
    <Hero />
    <div class="border-b border-line">
      <p class="shell py-5 text-meta text-ink-2">{mimirScopeNotice}</p>
    </div>
    <ScrollShowcase />
    <Models />
    <Solutions />
    <DataHandlingSection />
    <Pricing tone="wash" />
    <Partners />
    <FAQ />
    <Contact />
  </main>
  <Footer />
</Base>
