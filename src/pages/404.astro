---
import Base from "@/layouts/Base.astro";
import { notFoundHead } from "@/lib/seo";
import { routeAt } from "@/lib/site-data";
---

<Base head={notFoundHead()} bodyClass="bg-ink text-white">
  <main class="band-ink grid min-h-svh place-items-center">
    <div class="shell">
      <h1 class="text-[clamp(4.5rem,3rem+8vw,6rem)] [line-height:1] font-light">404</h1>
      <h2 class="mt-5 text-h3 font-medium">This page could not be found.</h2>
      <a href="/" class="btn btn-paper mt-10">{routeAt("/").label}</a>
    </div>
  </main>
</Base>
